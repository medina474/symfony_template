{% if action == 'replace' %}
<turbo-stream action="replace" target="tbody">
  <template>
    {% include 'country/index/body.html.twig' %}
  </template>
</turbo-stream>
{% else %}
<turbo-stream action="append" target="tbody">
  <template>
    {% include 'country/index/rows.html.twig' %}
  </template>
</turbo-stream>
{% endif %}

<turbo-stream action="replace" target="pagination">
  <template>
    {{ include('admin/pagination.html.twig', {
      route: 'app_country_index',
      nextCursor: nextCursor
    }) }}
  </template>
</turbo-stream>
