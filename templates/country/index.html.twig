{% extends 'admin.html.twig' %}

{% block title %}Pays{% endblock %}

{% block header %}
<header class="sticky top-0 z-30 px-2 pb-2 bg-neutral-50 shrink-0">
  <h1>Pays</h1>
  <div class="gap-2 flex">
    <form method="get"
      data-controller="search"
      data-search-delay-value="300"
      class="w-full">
      <input type="search" name="q"
        value="{{ search ?? '' }}"
        placeholder="Rechercher un pays"
        class="form-control"
        autocomplete="off"
        data-search-target="input"
        data-action="input->search#submit">
    </form>
    <div>
      <button class="btn btn-primary"
        onclick="winboxManager.open({ url:`{{ path('admin_country_new') }}`, title: `Pays`})">
      {{ 'button.add'|trans }}
      </button>
    </div>
  </div>
</header>
{% endblock %}

{% block body %}
<table class="tableau">
        <thead>
            <tr>
                <th scope="col">Code</th>
     	 		<th scope="col">Drapeau</th>
      			<th scope="col">Pays</th>
      			<th scope="col">Forme longue</th>
      			<th scope="col">Sepa</th>
            </tr>
        </thead>
    {{ include('/country/_items_tbody.html.twig', {countries: countries, q: q}, with_context: false) }}
</table>

{{ include('components/pagination_wrapper.html.twig', {
  route: 'app_country_index',
  nextCursor: nextCursor
}) }}
{% endblock %}
