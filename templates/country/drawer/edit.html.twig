{% extends 'admin/frames/drawer.html.twig' %}
{% set form_id = 'form-' ~ random() %}

{% block title %}Pays{% endblock %}

{% block main %}
  {{ include('country/_form.html.twig', {'button_label': 'Update'}) }}
{% endblock %}

{% block footer %}
<footer
  class="flex gap-4 justify-end">
  <button class="btn btn-primary" type="submit" form="{{ form_id }}" >{{ 'action.save'|trans }}</button>

    <form method="post" action="{{ path('app_country_delete_dialog', {'id': country.code}) }}">
        <button class="btn btn-danger">{{ 'action.delete'|trans }}</button>
    </form>
</footer>
{% endblock %}
